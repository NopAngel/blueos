#
# BlueOS Kernel Configuration
#

# --- Architecture ---
CONFIG_ARCH_RISCV=y
# CONFIG_ARCH_x86 is not set

# --- File Systems ---
CONFIG_FS_VFS=y
CONFIG_FS_9P=y
CONFIG_FS_EXT2=n
CONFIG_FS_FAT32=y
CONFIG_FS_RAMFS=y

# --- Drivers ---
CONFIG_DRIVER_KEYBOARD=y
CONFIG_DRIVER_RTC=y
CONFIG_DRIVER_SERIAL_UART=y
CONFIG_DRIVER_VGA=y
CONFIG_DRIVER_PCI=y
CONFIG_DRIVER_VIRTIO_9P=y

# --- Networking ---
CONFIG_NET=n
CONFIG_NET_E1000=n

# --- Debugging & Optimization ---
CONFIG_DEBUG_SYMBOLS=y
CONFIG_OPTIMIZATION_LEVEL_S=y